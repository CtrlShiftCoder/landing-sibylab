# --- Envío de correos (Resend: https://resend.com) ---
# 1) Crea cuenta en Resend y una API key (https://resend.com/api-keys)
# 2) Para pruebas locales puedes usar onboarding@resend.dev como FROM
#    y tu correo personal como TO (Resend solo entrega a tu cuenta en modo test).
# 3) En producción: verifica sibylab.com en https://resend.com/domains
#    y usa un FROM del dominio (ej. web@sibylab.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Destinatario(s) de los formularios (separar varios con coma)
CONTACT_TO_EMAIL=contacto@sibylab.com
# Remitente: debe pertenecer a un dominio verificado en Resend
# Prueba: "Sibylab Web <onboarding@resend.dev>"
# Prod:   "Sibylab Web <web@sibylab.com>"
CONTACT_FROM_EMAIL="Sibylab Web <web@sibylab.com>"

# --- Datos públicos (PLACEHOLDERS: reemplazar por los reales) ---
NEXT_PUBLIC_SITE_URL=https://sibylab.com
NEXT_PUBLIC_CONTACT_EMAIL=contacto@sibylab.com
NEXT_PUBLIC_SCHEDULE_URL=https://calendly.com/sibylab/reunion
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Analytics (PostHog: opcional; sin key el sitio funciona igual) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
